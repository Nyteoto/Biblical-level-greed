[Unit]
Description=Personal Growth System (tailnet server)
Documentation=file:///path/to/Iteration01/MOBILE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/Iteration01
# Loopback only. `tailscale serve` publishes it to the tailnet over HTTPS, so
# nothing needs to bind a routable address and there is no window where the
# port is open without TLS in front of it.
ExecStart=/path/to/Iteration01/.venv/bin/python /path/to/Iteration01/desktop.py --headless --port 8787
Restart=on-failure
RestartSec=10
# The daemon can take a moment after login; keep retrying rather than giving up.
StartLimitBurst=0

[Install]
WantedBy=default.target
