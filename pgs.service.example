[Unit]
Description=Personal Growth System (tailnet server)
Documentation=file:///path/to/Iteration01/MOBILE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/Iteration01
# --host tailscale binds this machine's tailnet address specifically, so the
# app is reachable by signed-in devices and by nothing else. If tailscaled is
# not up yet at boot, the unit fails and systemd retries.
ExecStart=/path/to/Iteration01/.venv/bin/python /path/to/Iteration01/desktop.py --headless --host tailscale --port 8787
Restart=on-failure
RestartSec=10
# The daemon can take a moment after login; keep retrying rather than giving up.
StartLimitBurst=0

[Install]
WantedBy=default.target
